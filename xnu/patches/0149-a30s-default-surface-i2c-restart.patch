 static uint32_t sweet_fb_swaps_logged;
+
+/*
+ * a30s bring-up: how much of a frame about to be shown is not black (an
+ * 8x8 grid of samples, RGB only), logged for the first 16 frames and then
+ * every 256th: tells "iOS draws nothing" from "the frame does not reach
+ * the panel".
+ */
+static void
+sweet_fb_check_frame(const uint8_t *buf, uint32_t stride, uint32_t w, uint32_t h)
+{
+	static uint32_t frames;
+	uint32_t n = frames++;
+	if (n >= 16 && (n % 256) != 0) {
+		return;
+	}
+	uint32_t lit = 0, first = 0;
+	for (uint32_t gy = 0; gy < 8; gy++) {
+		const uint32_t *row = (const uint32_t *)(buf + (uint64_t)((2 * gy + 1) * h / 16) * stride);
+		for (uint32_t gx = 0; gx < 8; gx++) {
+			uint32_t p = row[(2 * gx + 1) * w / 16];
+			if (p & 0x00ffffffu) {
+				if (lit++ == 0) {
+					first = p;
+				}
+			}
+		}
+	}
+	IOLog("SWEET FB: frame %u: %u/64 samples not black (first %#x)\n", n, lit, first);
+}
