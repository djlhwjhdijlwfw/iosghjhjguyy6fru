diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 19ef8ab..fcf2c5f 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -338,6 +338,35 @@ sweet_surface_create_physical(uint64_t phys, uint32_t width, uint32_t height,
 	return s;
 }
 
+SweetSurface *
+sweet_surface_create_kernel(uint32_t width, uint32_t height,
+    uint32_t bytesPerRow, uint32_t pixelFormat)
+{
+	SweetSurface *s = sweet_surface_alloc();
+	if (s == NULL) {
+		return NULL;
+	}
+	s->width = width;
+	s->height = height;
+	s->bytesPerRow = bytesPerRow;
+	s->bytesPerElement = 4;
+	s->elementWidth = s->elementHeight = 1;
+	s->pixelFormat = pixelFormat;
+	s->allocSize = (uint32_t)round_page(bytesPerRow * height);
+	IOBufferMemoryDescriptor *mem = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared, s->allocSize, page_size);
+	if (mem != NULL) {
+		bzero(mem->getBytesNoCopy(), s->allocSize);
+	}
+	s->memory = mem;
+	s->mapCache = kIOMapDefaultCache;
+	if (s->memory == NULL || !sweet_surface_publish(s)) {
+		s->release();
+		return NULL;
+	}
+	return s;
+}
