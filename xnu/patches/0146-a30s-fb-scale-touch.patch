+/*
+ * a30s copy path, scaled: every layer is composed into the cached fScaleBuf
+ * at panel resolution, each panel pixel taking the logical pixel under its
+ * centre (fScaleX/fScaleY), then the frame goes to the panel in one copy
+ * (composing in the scanned framebuffer showed frames drawn top-down).
+ */
+void
+AppleCLCD::presentScaled(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+	uint8_t *dst = (uint8_t *)fScaleBuf->getBytesNoCopy();
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (sweet_fb_swaps_logged < 16) {
+			sweet_fb_swaps_logged++;
+			IOLog("SWEET FB: swap %u layer %u surface %u %ux%u fmt 0x%x bpr %u a %d,%d b %d,%d %dx%d (scaled)\n",
+			    get32(rec, 0x50), layer, id, s ? s->width : 0, s ? s->height : 0,
+			    s ? s->pixelFormat : 0, s ? s->bytesPerRow : 0, sx, sy, dx, dy, w, h);
+		}
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		uintptr_t src = s->kernelAddress();
+		uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
+			dx = dy = 0;
+		}
+		/* clip in logical coordinates: to the surface and to the presented display */
+		if (w > (int32_t)s->width - sx) {
+			w = (int32_t)s->width - sx;
+		}
+		if (h > (int32_t)s->height - sy) {
+			h = (int32_t)s->height - sy;
+		}
+		if (w > (int32_t)fLogicalW - dx) {
+			w = (int32_t)fLogicalW - dx;
+		}
+		if (h > (int32_t)fLogicalH - dy) {
+			h = (int32_t)fLogicalH - dy;
+		}
+		uint64_t last = (uint64_t)s->offset + (uint64_t)(sy + h - 1) * s->bytesPerRow +
+		    (uint64_t)(sx + w) * 4;
+		if (w <= 0 || h <= 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 ||
+		    s->memory == NULL || last > s->memory->getLength()) {
+			src = 0;
+		}
+		if (src != 0) {
+			/* the panel columns and rows whose centre falls inside the layer */
+			uint32_t x0 = 0, x1, y0 = 0, y1;
+			while (x0 < fWidth && (int32_t)fScaleX[x0] < dx) {
+				x0++;
+			}
+			for (x1 = x0; x1 < fWidth && (int32_t)fScaleX[x1] < dx + w; x1++) {
+			}
+			while (y0 < fHeight && (int32_t)fScaleY[y0] < dy) {
+				y0++;
+			}
+			for (y1 = y0; y1 < fHeight && (int32_t)fScaleY[y1] < dy + h; y1++) {
+			}
+			const uint8_t *base = (const uint8_t *)(src + s->offset) + (uint64_t)sx * 4;
+			for (uint32_t y = y0; y < y1; y++) {
+				const uint32_t *in = (const uint32_t *)(base +
+				    (uint64_t)(sy + (int32_t)fScaleY[y] - dy) * s->bytesPerRow);
+				uint32_t *out = (uint32_t *)(dst + (uint64_t)y * fRowBytes);
+				for (uint32_t x = x0; x < x1; x++) {
+					out[x] = in[(int32_t)fScaleX[x] - dx];
+				}
+			}
+		}
+		s->release();
+	}
+	memcpy((void *)fPixels, dst, (size_t)fRowBytes * fHeight);
+}
