diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index 423617b..77a27a9 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -48,6 +48,17 @@
  * virt, hyp) instead of the usual 13/14/11/10: the virtual timer XNU uses
  * (CNTV) is INTID 16 + 3 = 19.
  */
+/*
+ * Bootstrap console (start.s, sweet_early.c, arm_vm_init.c): the panel the
+ * bootloader left lit, drawn before the ADT is read. a30s: S-BOOT's
+ * fb_handover at 0xEC000000, 720x1560 (sweet had ABL's 0x9c000000,
+ * 1080x2400). Mapped as one 32MB L2 block, so it must be 32MB aligned.
+ */
+#define SWEET_EARLY_FB_PA         0xEC000000
+#define SWEET_EARLY_FB_WIDTH      720
+#define SWEET_EARLY_FB_HEIGHT     1560
+#define SWEET_EARLY_FB_STRIDE     2880
+
 #define SWEET_VTIMER_INTID        19
 #define SWEET_IPI_SGI             1       // SGI used for cross-CPU signals
 
