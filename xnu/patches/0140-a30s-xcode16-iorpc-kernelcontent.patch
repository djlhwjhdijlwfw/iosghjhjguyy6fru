diff --git a/iokit/DriverKit/IORPC.h b/iokit/DriverKit/IORPC.h
index 3ded78c..c38e6d2 100644
--- a/iokit/DriverKit/IORPC.h
+++ b/iokit/DriverKit/IORPC.h
@@ -224,6 +224,17 @@ struct IORPC {
 	IORPCMessageMach * reply;
 	uint32_t           sendSize;
 	uint32_t           replySize;
+#ifdef KERNEL
+	/*
+	 * a30s: Xcode 16's iig (the oldest Xcode Codemagic offers) emits kernel
+	 * dispatch code that takes the parsed message from here instead of
+	 * calling IORPCMessageFromMach(), as xnu-11215 and later provide.
+	 * Filled wherever the kernel builds an IORPC (IOUserServer.cpp). The
+	 * kernel includes IOKit/IORPC.h, iig output DriverKit/IORPC.h: the two
+	 * copies must stay the same.
+	 */
+	IORPCMessage     * kernelContent;
+#endif /* KERNEL */
 };
 typedef struct IORPC IORPC;
 
