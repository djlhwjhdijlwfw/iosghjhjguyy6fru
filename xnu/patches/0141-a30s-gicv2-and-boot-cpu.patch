diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 6089db9..ac6e323 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -50,6 +50,60 @@ _gic_write32(vm_offset_t addr, uint32_t value)
 #define gicr_write32(offset, data) (_gic_write32(gicr_pe_base + (offset), (data)))
 #define gicr_read64(offset) (_gic_read64(gicr_pe_base + (offset)))
 
+#if defined(SWEET)
+/*
+ * a30s: the Exynos 7904 has a GIC-400 (GICv2): no redistributors and no
+ * system-register CPU interface, a memory-mapped one (GICC) instead.
+ */
+SECURITY_READ_ONLY_LATE(bool) sweet_gic_v2 = false;
+static vm_offset_t gicc_base;
+/* Each CPU's interface bit, for SGI target lists (from GICD_ITARGETSR0). */
+static uint8_t sweet_gicv2_cpumask[MAX_CPUS];
+
+#define gicc_read32(offset) (_gic_read32(gicc_base + (offset)))
+#define gicc_write32(offset, data) (_gic_write32(gicc_base + (offset), (data)))
+
+/* First string of a DT compatible property equals want. */
+static bool
+sweet_compatible_is(void const *prop, unsigned int size, const char *want)
+{
+	const char *s = prop;
+	unsigned int i = 0;
+
+	for (; want[i] != '\0'; i++) {
+		if (i >= size || s[i] != want[i]) {
+			return false;
+		}
+	}
+	return i < size && s[i] == '\0';
+}
+
+/* Per CPU: SGI/PPI enables and priorities are banked per CPU interface. */
+static void
+sweet_gicv2_init_cpu(void)
+{
+	for (unsigned int i = 0; i < 32; i += 4) {
+		gicd_write32(GICD_IPRIORITYR + i, 0xA0A0A0A0);
+	}
+	gicd_write32(GICD_ISENABLER, (1U << sweet_vtimer_intid) | (1U << SWEET_IPI_SGI));
+
+	/* GICD_ITARGETSR0..7 are read-only: each byte is this CPU's own bit. */
+	uint32_t mask = gicd_read32(GICD_ITARGETSR) & 0xff;
+	unsigned int cpu = ml_get_cpu_number_local();
+	if (mask == 0 || cpu >= MAX_CPUS) {
+		panic("%s: core %u has no GIC CPU interface (mask 0x%x)", __func__, cpu, mask);
+	}
+	sweet_gicv2_cpumask[cpu] = (uint8_t)mask;
+
+	gicc_write32(GICC_PMR, 0xFF);
+	gicc_write32(GICC_BPR, 0);
+	/* EnableGrp1, EOImodeNS = 0: the EOIR write also deactivates */
+	gicc_write32(GICC_CTLR, (gicc_read32(GICC_CTLR) & ~GICC_CTLR_EOIMODENS) | GICC_CTLR_ENABLEGRP1);
+	gicd_write32(GICD_CTLR, gicd_read32(GICD_CTLR) | GICD_CTLR_ENABLEGRP1);
+	kprintf("SWEET GIC: cpu %u GICv2 interface mask 0x%x\n", cpu, mask);
+}
+#endif /* SWEET */
+
 static vm_offset_t
 find_gicr_pe_base()
 {
@@ -117,6 +171,14 @@ pe_init_fiq()
 			sweet_vtimer_intid = intid;
 		}
 		kprintf("SWEET GIC: virtual timer INTID %u\n", sweet_vtimer_intid);
+
+		void const *compat;
+		unsigned int compat_size;
+		if (SecureDTGetProperty(entry, "compatible", &compat, &compat_size) == kSuccess &&
+		    sweet_compatible_is(compat, compat_size, "arm,gic-400")) {
+			sweet_gic_v2 = true;
+		}
+		kprintf("SWEET GIC: %s\n", sweet_gic_v2 ? "GICv2 (GIC-400): reg = GICD, GICC" : "GICv3");
 #endif
 
 		vm_offset_t soc_base_phys = pe_arm_get_soc_base_phys();
@@ -141,7 +203,22 @@ pe_init_fiq()
 		}
 
 		gicr_size = gicr_size_prop;
+#if defined(SWEET)
+		/* GICv2: the second region is the CPU interface, not redistributors */
+		if (sweet_gic_v2) {
+			gicc_base = gicr_base;
+			gicr_base = 0;
+			gicr_size = 0;
+		}
+#endif
+	}
+
+#if defined(SWEET)
+	if (sweet_gic_v2) {
+		sweet_gicv2_init_cpu();
+		return;
 	}
+#endif
 
 	// Find the redistributor for this processor
 	vm_offset_t gicr_pe_base = find_gicr_pe_base();
@@ -222,6 +299,61 @@ pe_init_fiq()
 	__builtin_arm_isb(ISB_SY);
 #endif /* SWEET */
 }
+
+#if defined(SWEET)
+/* Acknowledge the highest-priority pending Group 1 interrupt. */
+uint32_t
+sweet_gic_ack(uint32_t *intid)
+{
+	uint32_t iar;
+
+	if (sweet_gic_v2) {
+		/* Bits 12:10 name the CPU that sent an SGI: EOIR wants them back. */
+		iar = gicc_read32(GICC_IAR);
+		*intid = iar & GICC_IAR_INTID_MASK;
+	} else {
+		iar = (uint32_t)__builtin_arm_rsr64("ICC_IAR1_EL1");
+		*intid = iar & 0xFFFFFF;
+	}
+	return iar;
+}
+
+void
+sweet_gic_eoi(uint32_t iar)
+{
+	if (sweet_gic_v2) {
+		gicc_write32(GICC_EOIR, iar);
+	} else {
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
+	}
+}
+
+/* Cross-CPU signal (SGI SWEET_IPI_SGI) to logical CPU cpu, MPIDR mpidr. */
+void
+sweet_gic_send_sgi(unsigned int cpu, uint64_t mpidr)
+{
+	__builtin_arm_dsb(DSB_ISHST);
+	if (sweet_gic_v2) {
+		uint8_t mask = cpu < MAX_CPUS ? sweet_gicv2_cpumask[cpu] : 0;
+		if (mask == 0) {
+			panic("SWEET GIC: SGI to cpu %u before its GIC interface is known", cpu);
+		}
+		gicd_write32(GICD_SGIR, ((uint32_t)mask << 16) | GICD_SGIR_NSATT | SWEET_IPI_SGI);
+		return;
+	}
+	/* GICv3: the TARGET affinity, including Aff1, never the sender's MPIDR. */
+	unsigned int aff0 = mpidr & 0xff;
+	if (aff0 >= 16) {
+		panic("SWEET GIC: SGI target requires unsupported range selector");
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)SWEET_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(ISB_SY);
+}
+#endif /* SWEET */
 #else
 void
 pe_init_fiq()
