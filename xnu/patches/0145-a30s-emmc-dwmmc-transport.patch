 }
 
+/*
+ * eMMC transport (a30s). The Exynos 7904's eMMC sits behind a DesignWare
+ * mobile storage host (dwmmc0, Exynos 7 flavour with the SMU). S-BOOT leaves
+ * the card initialised and selected, at the bus width, timing and sample
+ * phase it chose; like the UFS path this reuses that state and never touches
+ * clocks or the card's bus settings. Polled PIO through the data FIFO, with
+ * the host's interrupts and internal DMA off, so no cache maintenance; the
+ * bounce buffer stays the only data buffer. 512-byte sectors, eight per
+ * 4 KiB device block; multi-block commands are preceded by CMD23.
+ */
+#define MMC_CTRL        0x000
+#define MMC_CLKDIV      0x008
+#define MMC_CLKENA      0x010
+#define MMC_TMOUT       0x014
+#define MMC_CTYPE       0x018
+#define MMC_BLKSIZ      0x01c
+#define MMC_BYTCNT      0x020
+#define MMC_INTMASK     0x024
+#define MMC_CMDARG      0x028
+#define MMC_CMD         0x02c
+#define MMC_RESP0       0x030
+#define MMC_RINTSTS     0x044
+#define MMC_STATUS      0x048
+#define MMC_USRID       0x068
+#define MMC_VERID       0x06c
+#define MMC_HCON        0x070
+#define MMC_UHS_REG     0x074
+#define MMC_BMOD        0x080
+#define MMC_IDSTS64     0x090                   /* 64-bit IDMAC layout */
+#define MMC_IDINTEN64   0x094
+#define MMC_CLKSEL64    0x0a8                   /* Exynos 7 */
+#define MMC_FORCE_CLK_STOP 0x0b0
+#define MMC_CDTHRCTL    0x100
+#define MMC_DDR_REG     0x10c
+#define MMC_HS400_DQS_EN 0x180
+#define MMC_MPSECURITY  0x1010
+#define MMC_MPSBEGIN0   0x1200                  /* Exynos SMU, region 0 */
+#define MMC_MPSEND0     0x1204
+#define MMC_MPSCTRL0    0x120c
+
+#define MMC_CTRL_FIFO_RESET     (1u << 1)
+#define MMC_CTRL_DMA_RESET      (1u << 2)
+#define MMC_CTRL_INT_ENABLE     (1u << 4)
+#define MMC_CTRL_DMA_ENABLE     (1u << 5)
+#define MMC_CTRL_USE_IDMAC      (1u << 25)
+#define MMC_BMOD_SWR            (1u << 0)
+#define MMC_BMOD_FB             (1u << 1)
+#define MMC_BMOD_DE             (1u << 7)
+
+#define MMC_INT_RE              (1u << 1)
+#define MMC_INT_CMD_DONE        (1u << 2)
+#define MMC_INT_DTO             (1u << 3)
+#define MMC_INT_TXDR            (1u << 4)
+#define MMC_INT_RXDR            (1u << 5)
+#define MMC_INT_RCRC            (1u << 6)
+#define MMC_INT_DCRC            (1u << 7)
+#define MMC_INT_RTO             (1u << 8)
+#define MMC_INT_DRTO            (1u << 9)
+#define MMC_INT_FRUN            (1u << 11)
+#define MMC_INT_HLE             (1u << 12)
+#define MMC_INT_SBE             (1u << 13)
+#define MMC_INT_EBE             (1u << 15)
+#define MMC_INT_CMD_ERR         (MMC_INT_RE | MMC_INT_RCRC | MMC_INT_RTO | MMC_INT_HLE)
+#define MMC_INT_DATA_ERR        (MMC_INT_DCRC | MMC_INT_DRTO | MMC_INT_FRUN | MMC_INT_SBE | MMC_INT_EBE)
+
+#define MMC_CMD_RESP_EXP        (1u << 6)
+#define MMC_CMD_RESP_CRC        (1u << 8)
+#define MMC_CMD_DAT_EXP         (1u << 9)
+#define MMC_CMD_DAT_WR          (1u << 10)
+#define MMC_CMD_PRV_DAT_WAIT    (1u << 13)
+#define MMC_CMD_STOP            (1u << 14)
+#define MMC_CMD_USE_HOLD        (1u << 29)
+#define MMC_CMD_START           (1u << 31)
+#define MMC_R1                  (MMC_CMD_RESP_EXP | MMC_CMD_RESP_CRC)
+
+#define MMC_STATUS_BUSY         (1u << 9)
+#define MMC_STATUS_FCNT(s)      (((s) >> 17) & 0x1fff)
+#define MMC_STATUS_DMA_REQ      (1u << 31)
+
+/* SMU region 0: whole card, normal world read/write (Linux's config_smu). */
+#define MMC_MPS_NS_RW           ((1u << 6) | (1u << 5) | (1u << 4) | (1u << 0))
+
+/* R1 card status */
+#define R1_STATE(r)             (((r) >> 9) & 0xf)
+#define R1_STATE_STBY           3
+#define R1_STATE_TRAN           4
+#define R1_SWITCH_ERROR         (1u << 7)
+#define R1_ERRORS               0xe4380000u     /* out of range, address, block length, WP, ECC, CC, error */
+
+#define MMC_SECTOR              512u
+#define MMC_PER_BLOCK           (UFS_BLOCK / MMC_SECTOR)
+#define MMC_FIFO_DEPTH          64u             /* entries: exynos7885.dtsi fifo-depth */
+#define MMC_CMD_TIMEOUT_NS      (100ull * NSEC_PER_MSEC)
+#define MMC_DATA_TIMEOUT_NS     (5ull * NSEC_PER_SEC)
+
+static uint64_t
+mmc_deadline(uint64_t ns)
+{
+	uint64_t t;
+	nanoseconds_to_absolutetime(ns, &t);
+	return mach_absolute_time() + t;
+}
+
+static int
+mmc_wait_busy(uint64_t ns)
+{
+	uint64_t deadline = mmc_deadline(ns);
+	while (ufs_rd(MMC_STATUS) & MMC_STATUS_BUSY) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: card still busy (status 0x%x)\n", ufs_rd(MMC_STATUS));
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	return 0;
+}
+
+static int
+mmc_ctrl_reset(uint32_t bits)
+{
+	uint64_t deadline = mmc_deadline(MMC_CMD_TIMEOUT_NS);
+	ufs_wr(MMC_CTRL, ufs_rd(MMC_CTRL) | bits);
+	while (ufs_rd(MMC_CTRL) & bits) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: reset 0x%x stuck (ctrl 0x%x)\n", bits, ufs_rd(MMC_CTRL));
+			return ETIMEDOUT;
+		}
+	}
+	return 0;
+}
+
+/* One command, the short response in *resp. Data, if any, is the caller's. */
+static int
+mmc_cmd(uint32_t idx, uint32_t arg, uint32_t flags, uint32_t *resp)
+{
+	/* Databook: a new command waits for the card to leave busy (not CMD13/CMD12). */
+	if (idx != 13 && !(flags & MMC_CMD_STOP)) {
+		int error = mmc_wait_busy(MMC_DATA_TIMEOUT_NS);
+		if (error) {
+			return error;
+		}
+	}
+	/* Writing CMD while the host still holds the last one raises HLE. */
+	uint64_t deadline = mmc_deadline(MMC_CMD_TIMEOUT_NS);
+	while (ufs_rd(MMC_CMD) & MMC_CMD_START) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: host still holds cmd 0x%x\n", ufs_rd(MMC_CMD));
+			return EBUSY;
+		}
+	}
+	ufs_wr(MMC_RINTSTS, ~0u);
+	ufs_wr(MMC_CMDARG, arg);
+	__builtin_arm_dsb(0xf);
+	ufs_wr(MMC_CMD, MMC_CMD_START | su.mmc_hold | flags | idx);
+
+	deadline = mmc_deadline(MMC_CMD_TIMEOUT_NS);
+	uint32_t st;
+	while (!((st = ufs_rd(MMC_RINTSTS)) & (MMC_INT_CMD_DONE | MMC_INT_HLE))) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: CMD%u timed out (cmd 0x%x rintsts 0x%x status 0x%x)\n",
+			    idx, ufs_rd(MMC_CMD), st, ufs_rd(MMC_STATUS));
+			return ETIMEDOUT;
+		}
+	}
+	ufs_wr(MMC_RINTSTS, st & (MMC_INT_CMD_DONE | MMC_INT_CMD_ERR));
+	if (st & MMC_INT_CMD_ERR) {
+		printf("SWEET MMC: CMD%u arg 0x%x failed (rintsts 0x%x)\n", idx, arg, st);
+		return (st & MMC_INT_RTO) ? ETIMEDOUT : EIO;
+	}
+	if (resp) {
+		*resp = ufs_rd(MMC_RESP0);
+	}
+	return 0;
+}
+
+static int
+mmc_status(uint32_t *r1)
+{
+	return mmc_cmd(13, su.mmc_rca << 16, MMC_R1, r1);
+}
+
+/* After a failed transfer: CMD12 (the card may still be sending or receiving), empty FIFO. */
+static void
+mmc_abort(void)
+{
+	uint32_t r1 = 0;
+	(void)mmc_cmd(12, 0, MMC_R1 | MMC_CMD_STOP, &r1);
+	(void)mmc_wait_busy(MMC_DATA_TIMEOUT_NS);
+	(void)mmc_ctrl_reset(MMC_CTRL_FIFO_RESET);
+	ufs_wr(MMC_RINTSTS, ~0u);
+}
+
+/*
+ * Data command idx with argument arg moving nsect sectors between buf and the
+ * card through the FIFO; CMD18/CMD25 get a CMD23 first, so no stop is needed.
+ */
+static int
+mmc_xfer(uint32_t idx, uint32_t arg, uint32_t nsect, bool write, void *buf)
+{
+	uint32_t r1 = 0, st = 0;
+	int error;
+
+	if (idx == 18 || idx == 25) {
+		error = mmc_cmd(23, nsect, MMC_R1, &r1);
+		if (error) {
+			return error;
+		}
+	}
+	if (MMC_STATUS_FCNT(ufs_rd(MMC_STATUS)) && (error = mmc_ctrl_reset(MMC_CTRL_FIFO_RESET))) {
+		return error;
+	}
+	ufs_wr(MMC_BLKSIZ, MMC_SECTOR);
+	ufs_wr(MMC_BYTCNT, nsect * MMC_SECTOR);
+	error = mmc_cmd(idx, arg, MMC_R1 | MMC_CMD_DAT_EXP | MMC_CMD_PRV_DAT_WAIT |
+	    (write ? MMC_CMD_DAT_WR : 0), &r1);
+	if (!error && (r1 & R1_ERRORS)) {
+		printf("SWEET MMC: CMD%u arg 0x%x: card status 0x%x\n", idx, arg, r1);
+		error = EIO;
+	}
+	if (error) {
+		mmc_abort();
+		return error;
+	}
+
+	/*
+	 * A 64-bit FIFO entry is moved as two 32-bit accesses, low word first,
+	 * like Samsung's kernel for this SoC (MMC_DW_FORCE_32BIT_SFR_RW).
+	 */
+	vm_offset_t fifo = su.regs + su.mmc_fifo;
+	bool wide = su.mmc_shift == 3;
+	uint32_t left = (nsect * MMC_SECTOR) >> su.mmc_shift;
+	uint32_t *w = (uint32_t *)buf;
+	uint64_t deadline = mmc_deadline(MMC_DATA_TIMEOUT_NS);
+	while (left) {
+		st = ufs_rd(MMC_RINTSTS);
+		if (st & MMC_INT_DATA_ERR) {
+			break;
+		}
+		uint32_t fcnt = MMC_STATUS_FCNT(ufs_rd(MMC_STATUS));
+		uint32_t n = MIN(left, write ? (fcnt < MMC_FIFO_DEPTH ? MMC_FIFO_DEPTH - fcnt : 0) : fcnt);
+		if (n == 0) {
+			if (mach_absolute_time() > deadline) {
+				break;
+			}
+			continue;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			if (write) {
+				*(volatile uint32_t *)fifo = *w++;
+				if (wide) {
+					*(volatile uint32_t *)(fifo + 4) = *w++;
+				}
+			} else {
+				*w++ = *(volatile uint32_t *)fifo;
+				if (wide) {
+					*w++ = *(volatile uint32_t *)(fifo + 4);
+				}
+			}
+		}
+		left -= n;
+		ufs_wr(MMC_RINTSTS, write ? MMC_INT_TXDR : MMC_INT_RXDR);
+	}
+	while (!left && !((st = ufs_rd(MMC_RINTSTS)) & (MMC_INT_DTO | MMC_INT_DATA_ERR))) {
+		if (mach_absolute_time() > deadline) {
+			break;
+		}
+	}
+	if (left || !(st & MMC_INT_DTO) || (st & MMC_INT_DATA_ERR)) {
+		printf("SWEET MMC: CMD%u arg 0x%x x%u %s failed: rintsts 0x%x status 0x%x, %u FIFO words left\n",
+		    idx, arg, nsect, write ? "write" : "read", st, ufs_rd(MMC_STATUS), left);
+		mmc_abort();
+		return (st & MMC_INT_DATA_ERR) ? EIO : ETIMEDOUT;
+	}
+	ufs_wr(MMC_RINTSTS, ~0u);
+	if (write) {
+		/* Programming: data busy until the card is done, then check what it says. */
+		error = mmc_wait_busy(MMC_DATA_TIMEOUT_NS);
+		if (!error) {
+			error = mmc_status(&r1);
+		}
+		if (!error && ((r1 & R1_ERRORS) || R1_STATE(r1) != R1_STATE_TRAN)) {
+			printf("SWEET MMC: write at 0x%x: card status 0x%x\n", arg, r1);
+			error = EIO;
+		}
+	}
+	return error;
+}
+
+/* nsect sectors at sector to/from the bounce buffer, inside the user area. */
+static int
+mmc_rw_sectors(uint64_t sector, uint32_t nsect, bool write)
+{
+	if (nsect == 0 || nsect > BOUNCE_SIZE / MMC_SECTOR || sector >= su.mmc_sectors ||
+	    nsect > su.mmc_sectors - sector || sector + nsect - 1 > UINT32_MAX) {
+		return EINVAL;
+	}
+	uint32_t idx = write ? (nsect > 1 ? 25 : 24) : (nsect > 1 ? 18 : 17);
+	return mmc_xfer(idx, (uint32_t)sector, nsect, write, (void *)(su.dma + DMA_BOUNCE));
+}
+
+/* CMD6: mode 2 clears bits of EXT_CSD[index], 3 writes the byte. */
+static int
+mmc_switch(uint8_t mode, uint8_t index, uint8_t value, uint64_t busy_ns)
+{
+	uint32_t r1 = 0;
+	int error = mmc_cmd(6, (uint32_t)mode << 24 | (uint32_t)index << 16 | (uint32_t)value << 8,
+	    MMC_R1, &r1);
+	if (!error) {
+		error = mmc_wait_busy(busy_ns);
+	}
+	if (!error) {
+		error = mmc_status(&r1);
+	}
+	if (!error && (r1 & (R1_ERRORS | R1_SWITCH_ERROR))) {
+		printf("SWEET MMC: SWITCH %u of EXT_CSD[%u] to 0x%x: card status 0x%x\n",
+		    mode, index, value, r1);
+		error = EIO;
+	}
+	return error;
+}
+
+static int
+mmc_flush(void)
+{
+	/* EXT_CSD[32] FLUSH_CACHE */
+	return su.mmc_cache ? mmc_switch(3, 32, 1, 30ull * NSEC_PER_SEC) : 0;
+}
+
+static int
+mmc_take_over_host(void)
+{
+	uint32_t verid = ufs_rd(MMC_VERID), hcon = ufs_rd(MMC_HCON), ctrl = ufs_rd(MMC_CTRL);
+	uint32_t bmod = ufs_rd(MMC_BMOD), clksel = ufs_rd(MMC_CLKSEL64);
+	uint32_t mps = ufs_rd(MMC_MPSCTRL0);
+	int error;
+
+	printf("SWEET MMC: verid 0x%x hcon 0x%x ctrl 0x%x bmod 0x%x status 0x%x rintsts 0x%x\n",
+	    verid, hcon, ctrl, bmod, ufs_rd(MMC_STATUS), ufs_rd(MMC_RINTSTS));
+	printf("SWEET MMC: clkdiv 0x%x clkena 0x%x ctype 0x%x uhs 0x%x ddr 0x%x clksel 0x%x cdthr 0x%x\n",
+	    ufs_rd(MMC_CLKDIV), ufs_rd(MMC_CLKENA), ufs_rd(MMC_CTYPE), ufs_rd(MMC_UHS_REG),
+	    ufs_rd(MMC_DDR_REG), clksel, ufs_rd(MMC_CDTHRCTL));
+	printf("SWEET MMC: last cmd 0x%x arg 0x%x, clkstop 0x%x dqs 0x%x, smu sec 0x%x ctrl 0x%x 0x%x-0x%x\n",
+	    ufs_rd(MMC_CMD), ufs_rd(MMC_CMDARG), ufs_rd(MMC_FORCE_CLK_STOP), ufs_rd(MMC_HS400_DQS_EN),
+	    ufs_rd(MMC_MPSECURITY), mps, ufs_rd(MMC_MPSBEGIN0), ufs_rd(MMC_MPSEND0));
+	if ((verid >> 16) != 0x5342) {          /* "SB" (Synopsys) */
+		printf("SWEET MMC: no DesignWare host here\n");
+		return ENXIO;
+	}
+	if (!(ufs_rd(MMC_CLKENA) & 1)) {
+		printf("SWEET MMC: card clock is off\n");
+		return ENXIO;
+	}
+	switch ((hcon >> 7) & 7) {              /* host data width */
+	case 1:
+		su.mmc_shift = 2;
+		break;
+	case 2:
+		su.mmc_shift = 3;
+		break;
+	default:
+		printf("SWEET MMC: unsupported FIFO width\n");
+		return ENXIO;
+	}
+	su.mmc_fifo = (verid & 0xffff) < 0x240a ? 0x100 : 0x200;
+	/* Exynos: the hold register is bypassed when no drive phase shift is set (Linux). */
+	su.mmc_hold = ((clksel >> 16) & 7) ? MMC_CMD_USE_HOLD : 0;
+
+	/*
+	 * Polled PIO: interrupts and the internal DMA off (Linux's IDMAC
+	 * teardown), then empty the FIFO. No controller reset: that would need
+	 * the clock registers re-sent to the card clock domain.
+	 */
+	ufs_wr(MMC_INTMASK, 0);
+	ufs_wr(MMC_CTRL, ctrl & ~(MMC_CTRL_INT_ENABLE | MMC_CTRL_DMA_ENABLE | MMC_CTRL_USE_IDMAC));
+	error = mmc_ctrl_reset(MMC_CTRL_DMA_RESET);
+	if (error) {
+		return error;
+	}
+	ufs_wr(MMC_BMOD, (bmod & ~(MMC_BMOD_DE | MMC_BMOD_FB)) | MMC_BMOD_SWR);
+	ufs_wr(MMC_IDSTS64, 0x337);
+	ufs_wr(MMC_IDINTEN64, 0);
+	uint64_t deadline = mmc_deadline(MMC_CMD_TIMEOUT_NS);
+	while (ufs_rd(MMC_STATUS) & MMC_STATUS_DMA_REQ) {
+		if (mach_absolute_time() > deadline) {
+			printf("SWEET MMC: DMA request stuck (status 0x%x)\n", ufs_rd(MMC_STATUS));
+			return ETIMEDOUT;
+		}
+	}
+	error = mmc_ctrl_reset(MMC_CTRL_FIFO_RESET);
+	if (error) {
+		return error;
+	}
+	ufs_wr(MMC_RINTSTS, ~0u);
+	ufs_wr(MMC_TMOUT, 0xffffffff);
+	if ((mps & MMC_MPS_NS_RW) != MMC_MPS_NS_RW || ufs_rd(MMC_MPSBEGIN0) != 0 ||
+	    ufs_rd(MMC_MPSEND0) != 0xffffffff) {
+		ufs_wr(MMC_MPSBEGIN0, 0);
+		ufs_wr(MMC_MPSEND0, 0xffffffff);
+		ufs_wr(MMC_MPSCTRL0, MMC_MPS_NS_RW);
+		printf("SWEET MMC: smu now ctrl 0x%x 0x%x-0x%x\n", ufs_rd(MMC_MPSCTRL0),
+		    ufs_rd(MMC_MPSBEGIN0), ufs_rd(MMC_MPSEND0));
+	}
+
+	/* The card: S-BOOT's RCA, 1 like Linux's. */
+	uint32_t r1 = 0;
+	for (su.mmc_rca = 1; su.mmc_rca <= 3; su.mmc_rca++) {
+		if ((error = mmc_status(&r1)) == 0) {
+			break;
+		}
+	}
+	if (error) {
+		printf("SWEET MMC: no card answers CMD13\n");
+		return ENXIO;
+	}
+	printf("SWEET MMC: card rca %u status 0x%x (state %u)\n", su.mmc_rca, r1, R1_STATE(r1));
+	if (R1_STATE(r1) == R1_STATE_STBY) {
+		error = mmc_cmd(7, su.mmc_rca << 16, MMC_R1, &r1);
+		if (!error) {
+			error = mmc_wait_busy(MMC_DATA_TIMEOUT_NS);
+		}
+	} else if (R1_STATE(r1) != R1_STATE_TRAN) {
+		mmc_abort();
+	}
+	if (!error) {
+		error = mmc_status(&r1);
+	}
+	if (error || R1_STATE(r1) != R1_STATE_TRAN) {
+		printf("SWEET MMC: card not in transfer state (status 0x%x)\n", r1);
+		return error ? error : EIO;
+	}
+
+	/* EXT_CSD (CMD8), one sector: always fits the FIFO. */
+	const uint8_t *ext = (const uint8_t *)(su.dma + DMA_BOUNCE);
+	error = mmc_xfer(8, 0, 1, false, (void *)(su.dma + DMA_BOUNCE));
+	if (error) {
+		/* Stock Android runs the card with command queueing, which refuses CMD8. */
+		printf("SWEET MMC: EXT_CSD read failed, retrying with command queueing off\n");
+		error = mmc_switch(3, 15, 0, MMC_DATA_TIMEOUT_NS);
+		if (!error) {
+			error = mmc_xfer(8, 0, 1, false, (void *)(su.dma + DMA_BOUNCE));
+		}
+		if (error) {
+			return error;
+		}
+	}
+	su.mmc_sectors = (uint64_t)ext[212] | (uint64_t)ext[213] << 8 |
+	    (uint64_t)ext[214] << 16 | (uint64_t)ext[215] << 24;
+	su.mmc_cache = ext[33] & 1;
+	uint8_t timing = ext[185] & 0xf, part = ext[179];
