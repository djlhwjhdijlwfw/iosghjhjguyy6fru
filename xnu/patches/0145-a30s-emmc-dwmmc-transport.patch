+	uint32_t mmc_fifo;                      /* data FIFO offset */
+	uint32_t mmc_shift;                     /* log2 of the FIFO width in bytes */
+	uint32_t mmc_hold;                      /* CMD.use_hold_reg or 0 */
+	bool mmc_cache;                         /* card cache on: flush on sync */
+	uint64_t mmc_sectors;                   /* user area, 512-byte sectors */
 } su;
 
 static LCK_GRP_DECLARE(sweet_ufs_grp, "sweet_ufs");
@@ -256,6 +268,494 @@ ufs_scsi(const uint8_t *cdb, unsigned cdb_len, uint32_t len, bool write)
